<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ masthead }} — {{ edition_date }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;600;900&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#fbfaf6; --ink:#1b1a18; --muted:#6c6660;
    --rule:#cfc8bd; --accent:#7a1f2b; --hair:#1b1a18;
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{
    margin:0; background:var(--paper); color:var(--ink);
    font-family:"Noto Serif JP",serif; line-height:1.5;
    padding:clamp(1rem,4vw,3rem) clamp(1rem,5vw,3rem);
  }
  .sheet{max-width:1100px;margin:0 auto}

  /* ---- masthead ---- */
  .masthead{text-align:center}
  .kicker{
    font-family:"Libre Caslon Text",serif; letter-spacing:.42em;
    font-size:.62rem; text-transform:uppercase; color:var(--accent);
    margin:0 0 .55rem; padding-left:.42em;
  }
  .title{
    font-weight:900; font-size:clamp(2.4rem,8vw,4.6rem);
    letter-spacing:.02em; line-height:.95; margin:0;
    border-top:3px solid var(--hair); border-bottom:1px solid var(--hair);
    padding:.35rem 0 .25rem;
  }
  .subtitle{
    font-size:.8rem; color:var(--muted); margin:.45rem 0 0;
    letter-spacing:.18em;
  }
  .dateline{
    display:flex; justify-content:space-between; align-items:center;
    border-top:1px solid var(--hair); border-bottom:1px solid var(--hair);
    margin-top:.7rem; padding:.3rem .1rem; font-size:.68rem;
    letter-spacing:.14em; text-transform:uppercase; color:var(--muted);
  }
  .dateline b{color:var(--ink);font-weight:600}

  /* ---- sections ---- */
  .section{margin-top:2.2rem}
  .section-head{
    display:flex; align-items:center; gap:.9rem;
    margin:0 0 1rem; color:var(--accent);
  }
  .section-head::before,.section-head::after{
    content:""; flex:1; height:1px; background:var(--rule);
  }
  .section-head span{
    font-size:.82rem; letter-spacing:.34em; text-transform:uppercase;
    font-weight:600; white-space:nowrap;
  }
  .sec-count{font-size:.62rem; color:var(--muted); letter-spacing:.14em;
             font-weight:400; margin-left:.4rem}

  /* ---- source groups ---- */
  .source-group{margin:1.4rem 0; padding-left:.8rem; border-left:2px solid var(--rule)}
  .source-title{
    font-size:.92rem; font-weight:700; color:var(--accent);
    margin:0 0 .55rem; letter-spacing:.04em;
    display:flex; align-items:center; gap:.6rem;
  }
  .source-title .grp-count{
    font-size:.66rem; color:var(--muted); font-weight:400;
    letter-spacing:.1em;
  }
  .source-arts{display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
               gap:.6rem 1.4rem}

  /* ---- articles ---- */
  .art{padding-bottom:.6rem; margin-bottom:.6rem;
       border-bottom:1px dotted var(--rule); break-inside:avoid}
  .art:last-child{border-bottom:none}
  .hl{font-weight:600; font-size:1.02rem; line-height:1.35; margin:0}
  .hl a{color:var(--ink); text-decoration:none;
        background:linear-gradient(var(--rule),var(--rule)) 0 1.15em/0 1px no-repeat;
        transition:background-size .2s}
  .hl a:hover{background-size:100% 1px; color:var(--accent)}
  .meta{font-size:.68rem; letter-spacing:.1em; text-transform:uppercase;
        color:var(--muted); margin:.35rem 0 0}
  .meta .src{color:var(--accent); font-weight:600}

  .empty{text-align:center; color:var(--muted); padding:3rem 0;
         font-size:1.1rem; letter-spacing:.1em}

  /* ---- market pulse (stock watch) ---- */
  .stock-watch{margin-top:2.6rem; --up:#b3261e; --down:#1d5fa6}
  .sw-edition{text-align:center; margin:-.4rem 0 .6rem; font-size:.78rem;
              letter-spacing:.3em; color:var(--accent)}
  .sw-asof{margin:0 0 .9rem; font-size:.74rem; letter-spacing:.06em; color:var(--muted)}
  .sw-stale{margin-left:.3em; color:var(--accent); font-size:.9em}
  .sw-headline{
    margin:0 0 1.4rem; padding:.7rem 1rem; font-weight:700;
    font-size:clamp(1.05rem,2.6vw,1.35rem); line-height:1.55;
    border-top:2px solid var(--hair); border-bottom:1px solid var(--rule);
    border-left:4px solid var(--accent);
  }
  .sw-scroll{overflow-x:auto}
  .stock-watch table{width:100%; border-collapse:collapse; margin:0 0 1.2rem; font-size:.82rem}
  .stock-watch th,.stock-watch td{padding:.35rem .6rem; text-align:left;
                                   border-bottom:1px dotted var(--rule)}
  .stock-watch th{color:var(--accent); font-weight:600; letter-spacing:.04em;
                   border-bottom:1px solid var(--hair); white-space:nowrap}
  .stock-watch .num{text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap}
  .stock-watch td.primary{font-weight:700}
  .stock-watch tr.stale td{color:var(--muted)}
  .pct.up{color:var(--up)} .pct.down{color:var(--down)}
  .pct.flat,.pct.na{color:var(--muted)}
  .sw-n{font-size:.7rem; color:var(--muted); letter-spacing:.04em}
  .sw-sub{font-size:.9rem; letter-spacing:.2em; color:var(--accent); margin:1.4rem 0 .6rem}
  .sw-movers,.sw-news,.sw-macro{list-style:none; margin:0; padding:0}
  .sw-mover{padding:.5rem 0 .6rem; border-bottom:1px dotted var(--rule)}
  .sw-mover:last-child{border-bottom:none}
  .sw-mover-head{margin:0; font-size:1rem; font-weight:600}
  .sw-period{font-size:.7rem; color:var(--muted); font-weight:400; letter-spacing:.08em}
  .sw-flag{display:inline-block; margin-left:.4rem; padding:0 .45rem;
           border:1px solid var(--accent); color:var(--accent);
           font-size:.66rem; font-weight:600; letter-spacing:.06em; white-space:nowrap}
  .sw-meta{margin:.15rem 0 .3rem; font-size:.68rem; color:var(--muted); letter-spacing:.06em}
  .sw-news li{font-size:.86rem; line-height:1.4; margin:.15rem 0; padding-left:.9rem; position:relative}
  .sw-news li::before{content:"▸"; position:absolute; left:0; color:var(--accent)}
  .sw-news a{color:var(--ink); text-decoration:none; border-bottom:1px solid var(--rule)}
  .sw-news a:hover{color:var(--accent); border-bottom-color:var(--accent)}
  .sw-src{font-size:.66rem; color:var(--muted); letter-spacing:.06em}
  .sw-nonews,.sw-none{margin:.1rem 0; font-size:.78rem; color:var(--muted)}
  .sw-macro{display:flex; flex-wrap:wrap; gap:.3rem 1.4rem; margin:1.4rem 0 1rem;
            padding:.5rem 0; border-top:1px solid var(--rule); border-bottom:1px solid var(--rule);
            font-size:.82rem; font-variant-numeric:tabular-nums}
  .sw-macro .sw-label{font-weight:600}
  .sw-details{margin:.6rem 0 0}
  .sw-details summary{cursor:pointer; font-size:.8rem; color:var(--accent); letter-spacing:.06em;
                      padding:.3rem 0}
  .sw-fail{margin:.6rem 0 0; font-size:.68rem; color:var(--muted)}
  @media(max-width:600px){
    .stock-watch th,.stock-watch td{padding:.3rem .4rem}
    .sw-headline{padding:.6rem .7rem}
    .sw-macro{flex-direction:column}
  }

  footer{margin-top:2.6rem; border-top:3px double var(--hair);
         padding-top:.7rem; display:flex; justify-content:space-between;
         font-size:.64rem; letter-spacing:.12em; text-transform:uppercase;
         color:var(--muted)}
  footer a{color:var(--accent)}

  @media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="sheet">

  <header class="masthead">
    {% if kicker %}<p class="kicker">{{ kicker }}</p>{% endif %}
    <h1 class="title">{{ masthead }}</h1>
    {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
    <div class="dateline">
      <span><b>{{ edition_date }}</b></span>
      <span>{% if is_latest %}最新号{% else %}過去号{% endif %} · 全{{ total }}本</span>
      <span>自動編集</span>
    </div>
  </header>

  {% if total == 0 %}
    <p class="empty">本日の更新はありません。</p>
  {% endif %}

  {% for sec in sections %}
  {% if sec.groups %}
  <section class="section">
    <div class="section-head"><span>{{ sec.name }}</span><small class="sec-count">{{ sec.total }}本</small></div>
    {% for grp in sec.groups %}
      <div class="source-group">
        <h3 class="source-title">{{ grp.source }} <span class="grp-count">{{ grp.arts|length }}</span></h3>
        <div class="source-arts">
          {% for a in grp.arts %}
          <article class="art">
            <p class="hl">{% if a.url %}<a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a>{% else %}{{ a.title }}{% endif %}</p>
            {% if a.date_display %}<p class="meta">{{ a.date_display }}</p>{% endif %}
          </article>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </section>
  {% endif %}
  {% endfor %}

  {% macro pct(p) %}<span class="pct {{ p.cls }}">{{ p.text }}</span>{% endmacro %}

  {% if stock %}
  <section class="section stock-watch">
    <div class="section-head"><span>Market Pulse</span></div>
    {% if stock.weekly %}<p class="sw-edition">先週の振り返り</p>{% endif %}

    <p class="sw-asof">
      {% for m in stock.markets %}{% if not loop.first %}・{% endif %}{{ m.name }} {{ m.date }}終値{% if m.stale %}<span class="sw-stale">（前回から更新なし）</span>{% endif %}{% endfor %}
    </p>

    {% if stock.headline %}<p class="sw-headline">{{ stock.headline }}</p>{% endif %}

    {% if stock.themes %}
    <div class="sw-scroll">
      <table class="sw-themes">
        <thead><tr><th>テーマ</th><th class="num">前日比</th><th class="num">週間</th></tr></thead>
        <tbody>
        {% for t in stock.themes %}
          <tr>
            <td>{{ t.name }} <span class="sw-n">{{ t.n }}銘柄</span></td>
            <td class="num{% if not stock.weekly %} primary{% endif %}">{{ pct(t.daily) }}</td>
            <td class="num{% if stock.weekly %} primary{% endif %}">{{ pct(t.weekly) }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

    <h3 class="sw-sub">目立った動き</h3>
    {% if stock.movers %}
    <ul class="sw-movers">
      {% for m in stock.movers %}
      <li class="sw-mover">
        <p class="sw-mover-head">
          <span class="sw-label">{{ m.label }}</span>
          <span class="sw-period">{{ m.period }}</span> {{ pct(m.pct) }}
          {% for f in m.flags %}<span class="sw-flag">{{ f }}</span>{% endfor %}
        </p>
        <p class="sw-meta">{{ m.symbol }} · {{ m.theme }}</p>
        {% if m.headlines %}
        <ul class="sw-news">
          {% for h in m.headlines %}
          <li><a href="{{ h.url }}" target="_blank" rel="noopener noreferrer">{{ h.title }}</a>{% if h.source %} <span class="sw-src">{{ h.source }}</span>{% endif %}</li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="sw-nonews">関連見出しなし</p>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="sw-none">目立った動きなし</p>
    {% endif %}

    {% if stock.macro %}
    <ul class="sw-macro">
      {% for m in stock.macro %}
      <li><span class="sw-label">{{ m.label }}</span> {{ m.close }} {{ pct(m.daily) }}{% if stock.weekly %} <span class="sw-period">週間</span> {{ pct(m.weekly) }}{% endif %}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if stock.tickers %}
    <details class="sw-details">
      <summary>全銘柄の詳細（{{ stock.tickers|length }}銘柄）</summary>
      <div class="sw-scroll">
        <table>
          <thead><tr><th>銘柄</th><th>テーマ</th><th class="num">終値</th><th class="num">前日比</th><th class="num">週間</th><th>備考</th></tr></thead>
          <tbody>
          {% for t in stock.tickers %}
            <tr{% if t.stale %} class="stale"{% endif %}>
              <td>{{ t.label }} <span class="sw-n">{{ t.symbol }}</span></td>
              <td>{{ t.theme }}</td>
              <td class="num">{{ t.close }}</td>
              <td class="num">{{ pct(t.daily) }}</td>
              <td class="num">{{ pct(t.weekly) }}</td>
              <td>{% for f in t.flags %}<span class="sw-flag">{{ f }}</span>{% endfor %}{% if t.stale %}<span class="sw-stale">更新なし（基準日 {{ t.asof }}）</span>{% endif %}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </details>
    {% endif %}

    {% if stock.failures %}
    <p class="sw-fail">取得できなかった銘柄: {{ stock.failures|join('、') }}</p>
    {% endif %}
  </section>
  {% endif %}

  <footer>
    <span>{{ generated }} 生成</span>
    <span><a href="archive/index.html">過去号一覧 →</a></span>
  </footer>

</div>
</body>
</html>
